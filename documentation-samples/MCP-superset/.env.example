# ---------------------------------------------------------------------------
# Demo credentials for the Olist + StarRocks + Superset MCP demo.
#
# Setup:  cp .env.example .env   (then edit .env if you use your own values)
#
# .env is gitignored; .env.example is committed as the template. Three things
# read this file: docker compose (for the compose stack and the Superset
# containers' env_file), the aistor MCP server (docker --env-file), and the
# StarRocks MCP server (a `set -a; source` wrapper in .mcp.json).
#
# The values below are the *compose-provisioned demo defaults* -- fine to use
# as-is for the local demo. Replace them in your .env if you generated your own
# MinIO keys or changed ports.
# ---------------------------------------------------------------------------

# --- MinIO / aistor MCP server ---
# host.docker.internal (not localhost): the aistor MCP runs in its own container.
MINIO_ENDPOINT=host.docker.internal:9000
# Root (admin) login for the MinIO server + `mc` alias in docker-compose.yml.
MINIO_ROOT_USER=miniouser
MINIO_ROOT_PASSWORD=M!n10R0cks
# Service-account access key (created by the minio_mc bootstrap) used by StarRocks.
MINIO_ACCESS_KEY=AAAAAAAAAAAAAAAAAAAA
MINIO_SECRET_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
MINIO_USE_SSL=false
# Bucket backing the StarRocks storage volume. Created by the minio_mc service
# at startup; must match the LOCATIONS in storage_volume.sql.
STARROCKS_BUCKET=my-starrocks-bucket

# --- StarRocks MCP server ---
# Format: user:password@host:port/database  (demo root has no password)
STARROCKS_URL=root:@localhost:9030/olist

# --- Plotly chart output (StarRocks MCP server) ---
# Interactive HTML charts (+ a PNG preview) from the StarRocks MCP server land
# here. Anchored to the project root via ${CLAUDE_PROJECT_DIR} so it resolves the
# same from a terminal or the Desktop app. NOTE: the StarRocks server bash-sources
# this file, so the variable expands there; docker compose and the aistor
# container read it literally but ignore this variable, so that's harmless.
STARROCKS_CHART_OUTPUT_DIR=${CLAUDE_PROJECT_DIR:-.}/DEMO_Output

# --- Superset ---
# Superset refuses to start with its built-in default key. Any long random
# string works for the demo: openssl rand -base64 42
SUPERSET_SECRET_KEY=demo-only-not-for-production-hcQ3vN8pS1wR6yT0zL5xB2mK
# Superset image tag to build the demo image from (see Dockerfile.superset).
# 6.1.0 is the first release that ships the MCP service.
SUPERSET_VERSION=6.1.0
# Superset UI login, created by the superset-init service. The password is not
# "admin" because browsers match that against their breached-password lists and
# warn on every login.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=SuperSetR0cks!
# The URL you open in a browser. Used for the chart/dashboard links the MCP
# service hands back to Claude.
SUPERSET_PUBLIC_URL=http://localhost:8088/

# --- Superset MCP service ---
# The Superset user the MCP service acts as. Single-user development auth:
# no token, so keep port 5008 on localhost. See superset_config.py.
MCP_DEV_USERNAME=admin

# --- Superset -> StarRocks database connection (created by superset-init) ---
# Name shown in the Superset UI and to the MCP tools.
SUPERSET_STARROCKS_DB_NAME=StarRocks
# starrocks://<user>:<password>@<host>:<port>/<catalog>.<database>
# starrocks-fe (not localhost): Superset connects over the compose network.
SUPERSET_STARROCKS_URI=starrocks://root:@starrocks-fe:9030/default_catalog.olist
